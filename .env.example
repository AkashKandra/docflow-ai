# Copy to .env for scripts (the Functions host reads local.settings.json instead).
# DOCFLOW_MODE=mock runs everything offline (no Azure needed). Use "azure" for real services.
DOCFLOW_MODE=mock
DOCFLOW_LOCAL_DIR=.local_data

AzureWebJobsStorage=UseDevelopmentStorage=true
DOCUMENT_INTELLIGENCE_ENDPOINT=
DOCUMENT_INTELLIGENCE_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
EMBEDDING_DIM=1536
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX=docflow-documents

# Business rules
CONFIDENCE_THRESHOLD=0.85
HIGH_VALUE_THRESHOLD=100000

# Graph backfill script only
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=
