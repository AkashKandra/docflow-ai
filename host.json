{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": { "isEnabled": true, "excludedTypes": "Request" }
    }
  },
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  },
  "extensions": {
    "queues": {
      "maxPollingInterval": "00:00:02",
      "visibilityTimeout": "00:02:00",
      "batchSize": 8,
      "newBatchThreshold": 4,
      "maxDequeueCount": 5,
      "messageEncoding": "none"
    }
  },
  "functionTimeout": "00:10:00"
}
